{
  "name": "taskio",
  "displayName": "Taskio - TODO List",
  "description": "Turn TODO comments into real tasks",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "publisher": "taskio",
  "icon": "assets/taskio-icon.png",
  "repository": {
    "type": "git", 
    "url": "https://github.com/criszst/taskio.git"
  },

  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "todo",
    "todo comments",
    "todo tree",
    "task",
    "tasks",
    "task list",
    "task manager",
    "task tracker",
    "comments",
    "code comments",
    "productivity",
    "developer productivity",
    "vscode todo",
    "vscode tasks"
  ],

  "activationEvents": [
    "onStartupFinished"
  ],

  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "view/item/context": [
        {
          "command": "taskio.copyComment",
          "when": "view == taskioView && viewItem == taskioComment",
          "group": "inline"
        }

      ],

      "view/title": [
        {
          "command": "taskio.searchTasks",
          "when": "view == taskioView",
          "group": "navigation@1"
        },

        {
          "command": "taskio.organize",
          "when": "view == taskioView",
          "group": "navigation@2"
        },
        
        {
          "command": "taskio.exportTasks",
          "when": "view == taskioView",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "taskio.searchTasks",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@1"
        },

        {
          "command": "taskio.organize",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@2"
        },

        {
          "command": "taskio.exportTasks",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@3"
        }

      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskio-tree",
          "title": "Taskio",
          "icon": "assets/taskio.svg"
        }
      ]
    },
    "views": {
      "taskio-tree": [
        {
          "id": "taskioView",
          "name": "Tree View",
          "icon": "assets/taskio.svg"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Taskio Configuration",
      "properties": {

        "taskio.keywords": {
          "type": "array",
          "default": [
            "TODO",
            "FIXME",
            "BUG"
          ],
          "description": "Keywords recognized by Taskio inside comments"
        },

        "taskio.color": {
          "type": "string",
          "default": "#6042f5",
          "description": "Highlight color for Taskio tasks (in hex format)."
        },

        "taskio.enhanceAllText": {
          "type": "boolean",
          "default": false,
          "description": "Enhance all text comment after TODO (or other keywords)."
        },

        "taskio.priorityMarkers": {
          "type": "object",
          "default": {
            "high": "!!!",
            "medium": "!!",
            "low": "!"
          },
          "description": "Priority markers based on repeated characters after the keyword"
        },

        "taskio.showStatistics": {
          "type": "boolean",
          "default": true,
          "description": "Show statistics panel in the Taskio view"
        }
      }
    },
    "commands": [
      {
        "command": "taskio.copyComment",
        "title": "Copy",
        "enablement": "view == taskioView"
      },

      {
        "command": "taskio.searchTasks",
        "title": "Search Tasks",
        "icon": "$(search)",
        "enablement": "view == taskioView"
      }, 
      
      {
        "command": "taskio.organize",
        "title": "Organize Tasks by Mode",
        "icon": "$(list-unordered)",
        "enablement": "view == taskioView"
      },

      {
        "command": "taskio.exportTasks",
        "title": "Export Tasks",
        "icon": "$(export)",
        "enablement": "view == taskioView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}