{
  "name": "taskio",
  "displayName": "Taskio - TODO List",
  "description": "Turn TODO comments into real tasks",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.70.0"
  },
  "publisher": "taskio",
  "icon": "assets/taskio-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/criszst/taskio.git"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "todo",
    "todo comments",
    "todo tree",
    "task",
    "tasks",
    "task list",
    "task manager",
    "task tracker",
    "comments",
    "code comments",
    "productivity",
    "developer productivity",
    "vscode todo",
    "vscode tasks"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "view/item/context": [
        {
          "command": "taskio.CopyComment",
          "when": "view == taskioView && viewItem == taskioComment",
          "group": "inline"
        },
        {
          "command": "taskio.RemoveTask",
          "when": "view == taskioView && viewItem == taskioComment",
          "group": "inline"
        },
        {
          "command": "taskio.trello.SendTask",
          "when": "view == taskioView && viewItem == taskioComment"
        }
      ],
      "view/title": [
        {
          "command": "taskio.SearchTasks",
          "when": "view == taskioView",
          "group": "navigation@1"
        },
        {
          "command": "taskio.Refresh",
          "when": "view == taskioView",
          "group": "navigation@2"
        },
        {
          "command": "taskio.Organize",
          "when": "view == taskioView",
          "group": "navigation@3"
        },
        {
          "command": "taskio.ExportTasks",
          "when": "view == taskioView",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "taskio.SearchTasks",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@1"
        },
        {
          "command": "taskio.Refresh",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@2"
        },
        {
          "command": "taskio.Organize",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@3"
        },
        {
          "command": "taskio.ExportTasks",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskio-tree",
          "title": "Taskio",
          "icon": "assets/taskio.svg"
        }
      ]
    },
    "views": {
      "taskio-tree": [
        {
          "id": "taskioView",
          "name": "Tree View",
          "icon": "assets/taskio.svg"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Taskio Configuration",
      "properties": {
        "taskio.keywords": {
          "type": "array",
          "default": [
            "TODO",
            "FIXME",
            "BUG"
          ],
          "description": "Keywords recognized by Taskio inside comments"
        },
        "taskio.color": {
          "type": "string",
          "default": "#6042f5",
          "description": "Highlight color for Taskio tasks (in hex format)."
        },
        "taskio.enhanceAllText": {
          "type": "boolean",
          "default": false,
          "description": "Enhance all text comment after TODO (or other keywords)."
        },
        "taskio.priorityMarkers": {
          "type": "object",
          "default": {
            "high": "!!!",
            "medium": "!!",
            "low": "!"
          },
          "description": "Priority markers based on repeated characters after the keyword"
        },
        "taskio.trello.boardId": {
          "type": "string",
          "default": "",
          "description": "Board ID for Trello integration (optional)"
        },
        "taskio.trello.listId": {
          "type": "string",
          "default": "",
          "description": "List ID for Trello integration (optional)"
        }
      }
    },
    "commands": [
      {
        "command": "taskio.CopyComment",
        "title": "Copy Comment",
        "icon": "$(copy)",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.SearchTasks",
        "title": "Search Tasks",
        "icon": "$(search)",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.Refresh",
        "title": "Refresh Tree View",
        "icon": "$(refresh)",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.Organize",
        "title": "Organize Tasks by Mode",
        "icon": "$(list-unordered)",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.ExportTasks",
        "title": "Export Tasks",
        "icon": "$(export)",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.RemoveTask",
        "title": "Remove Task",
        "icon": "$(trash)",
        "enablement": "view == taskioView && viewItem == taskioComment"
      },

      {
        "command": "taskio.trello.SetupIntegration",
        "title": "Setup Trello Integration",
        "category": "Taskio - Trello"
      },
      
      {
        "command": "taskio.trello.SendTask",
        "title": "Send Task to Trello",
        "category": "Taskio - Trello"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "@types/vscode": "^1.70.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
