{
  "name": "taskio",
  "displayName": "Taskio",
  "description": "Turn TODO comments into real taks",
  "version": "0.0.1",
  "engines": {
    "vscode": "1.108.0"
  },
  "categories": [
    "Visualization",
    "Themes",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "menus": {
      "view/item/context": [
        {
          "command": "taskio.copyComment",
          "when": "view == taskioView && viewItem == taskioComment",
          "group": "inline"
        }

      ],

      "view/title": [
        {
          "command": "taskio.searchTodos",
          "when": "view == taskioView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "taskio.searchTodos",
          "when": "explorerResourceIsFolder == false",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskio-tree",
          "title": "Taskio",
          "icon": "resources/package-explorer.svg"
        }
      ]
    },
    "views": {
      "taskio-tree": [
        {
          "id": "taskioView",
          "name": "Tree View"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Taskio Configuration",
      "properties": {

        "taskio.keywords": {
          "type": "array",
          "default": [
            "TODO",
            "FIXME",
            "BUG"
          ],
          "description": "Keywords recognized by Taskio inside comments"
        },

        "taskio.color": {
          "type": "string",
          "default": "#6042f5",
          "description": "Highlight color for Taskio tasks (in hex format)."
        },

        "taskio.enhanceAllText": {
          "type": "boolean",
          "default": false,
          "description": "Enhance all text comment after TODO (or other keywords)."
        },

        "taskio.priorityMarkers": {
          "type": "object",
          "default": {
            "high": "!!!",
            "medium": "!!",
            "low": "!"
          },
          "description": "Priority markers based on repeated characters after the keyword"
        },

        "taskio.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable notifications for Taskio."
        },

        "taskio.taskListLocation": {
          "type": "string",
          "enum": [
            "Side Panel",
            "Bottom Panel",
            "Floating Window"
          ],
          "default": "Side Panel",
          "description": "Location of the Taskio task list panel."
        }
      }
    },
    "commands": [
      {
        "command": "taskio.copyComment",
        "title": "Copy",
        "enablement": "view == taskioView"
      },
      {
        "command": "taskio.searchTodos",
        "title": "🔍︎",
        "enablement": "view == taskioView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.52.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}